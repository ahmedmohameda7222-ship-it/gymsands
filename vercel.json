{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "feat/p10f-activity-catalog-v2-cutover": true
    }
  },
  "crons": [
    {
      "path": "/api/internal/maintenance/oauth-cleanup",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/internal/maintenance/privacy-lifecycle",
      "schedule": "47 3 * * *"
    },
    {
      "path": "/api/internal/maintenance/workout-history-lifecycle",
      "schedule": "37 3 * * *"
    },
    {
      "path": "/api/internal/maintenance/billing-events",
      "schedule": "7 4 * * *"
    }
  ]
}